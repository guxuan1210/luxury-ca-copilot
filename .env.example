# Copy this file to .env and fill in real values. .env is gitignored.
# The tool uses an Anthropic-compatible API endpoint.

# Anthropic-compatible endpoint base URL
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Model name
ANTHROPIC_MODEL=deepseek-v4-pro

# API key / auth token
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx
